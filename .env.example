# Heimdall ---------------------------------------------------------------
# 32-byte hex secret. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
HEIMDALL_SECRET=replace-with-random-32-byte-hex

# Gemini ----------------------------------------------------------------
# If unset, backend reads ./GEMINI_KEY.txt as a fallback for dev convenience.
GEMINI_API_KEY=

# Lobster Trap ----------------------------------------------------------
# If unset or pointing to an unreachable host, backend uses the built-in
# mock proxy that calls Gemini directly and synthesises detected_intent
# from a regex policy. To use the real Veea binary, set this to the proxy:
#   LOBSTER_TRAP_URL=http://localhost:8080/v1/chat/completions
LOBSTER_TRAP_URL=

# Sepolia ---------------------------------------------------------------
# If any of these are unset, the DeFi executor returns a deterministic
# mock txhash with a realistic Etherscan URL. Set all three for real txs.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
SEPOLIA_TO_ADDRESS=
