# === Required for production ===
# 32-byte hex secret. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
HEIMDALL_SECRET=replace-with-random-32-byte-hex

# Comma-separated list of allowed CORS origins for the dashboard.
# Use "*" for any (development only).
HEIMDALL_ALLOWED_ORIGINS=http://localhost:3000

# === Optional: pin a known demo key (otherwise auto-generated, shown once in logs) ===
# If unset, the first boot mints a fresh hd_test_* key and logs it between two
# === banners. After that it's gone — only the hash is stored.
HEIMDALL_DEMO_API_KEY=

# Where the SQLite file lives. In Docker the compose file mounts a volume at
# /app/data, so leave this blank for local dev and the container picks it up.
HEIMDALL_DB_PATH=

# === Gemini ===
# If unset, the backend reads ./GEMINI_KEY.txt as a dev fallback. If neither is
# set, incident reports stream deterministic mock content.
GEMINI_API_KEY=

# === Optional: real Lobster Trap DPI proxy ===
# If unset or pointing at an unreachable host, the backend uses a built-in mock
# proxy. To use the real Veea binary:
#   LOBSTER_TRAP_URL=http://lobstertrap:8080/v1/chat/completions
# (combine with `docker compose --profile dpi up` to bring the proxy up.)
LOBSTER_TRAP_URL=

# === Optional: real Sepolia for the DeFi demo's execute_trade tool ===
# If any of these are unset the executor returns a deterministic mock txhash.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
SEPOLIA_TO_ADDRESS=

# === Frontend build-time ===
# Passed into the Next.js build so the dashboard knows where the API lives.
NEXT_PUBLIC_API_URL=http://localhost:8000
